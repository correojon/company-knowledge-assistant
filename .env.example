# Sentinel: keep this line. Without it the backend prints a "no .env file found" notice.
CONFIG_FILE_LOADED=true

# Language model provider: fake (canned replies), ollama (local model) or openai_compat (hosted).
LLM_PROVIDER=ollama

# Ollama URL for local runs. Compose overrides it for containers.
OLLAMA_BASE_URL=http://localhost:11434

# Local Ollama model name (final value set by ADR-001).
OLLAMA_MODEL=llama3.2:3b

# OpenAI-compatible API base URL, e.g. https://api.groq.com/openai/v1. Required for openai_compat.
OPENAI_COMPAT_BASE_URL=

# OpenAI-compatible API key. Required for openai_compat. Never commit or log it.
OPENAI_COMPAT_API_KEY=

# OpenAI-compatible model name. Required for openai_compat.
OPENAI_COMPAT_MODEL=

# Generation timeout in seconds.
LLM_TIMEOUT_SECONDS=120

# Embedding model (used from Feature 003).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Data directory for the database. Compose overrides it to /data.
DATA_DIR=./data

# Compose only: host port for the backend.
BACKEND_PORT=8000

# Compose only: host port for the web interface.
FRONTEND_PORT=5173

# Frontend (Vite) only: where /api is proxied. Compose sets http://backend:8000.
API_PROXY_TARGET=http://localhost:8000
